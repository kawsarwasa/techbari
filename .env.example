DJANGO_SECRET_KEY=change-this-before-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=techbari
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Staff authentication / session security
STAFF_AUTH_ENABLED=1
STAFF_IDLE_TIMEOUT=1800
SESSION_COOKIE_AGE=28800
# Keep these 0 for local HTTP development; use 1 on HTTPS production.
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# Password reset email. Console backend is useful for local development.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@techbari.local
