DJANGO_SECRET_KEY=change-this-before-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=techbari
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Staff authentication / session security
STAFF_AUTH_ENABLED=1
STAFF_IDLE_TIMEOUT=1800
SESSION_COOKIE_AGE=28800
# SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE default to secure when DJANGO_DEBUG=0.
# Override them only when your deployment has a specific proxy/HTTPS requirement.

# Email / SMTP. Console backend is useful for local development.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@techbari.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15

# v2.8 Notifications / Integrations secrets. Never put these in dashboard fields.
SMS_API_TOKEN=
WHATSAPP_API_TOKEN=
META_CAPI_ACCESS_TOKEN=
# Keep Graph API version configurable so it can be upgraded without a code release.
META_GRAPH_API_VERSION=
META_CAPI_BASE_URL=https://graph.facebook.com
GA4_API_SECRET=
GA4_MEASUREMENT_PROTOCOL_URL=https://www.google-analytics.com/mp/collect

# Generic courier fallback secrets.
COURIER_API_TOKEN=
COURIER_WEBHOOK_SECRET=

# Per-courier variables use the provider CODE configured in Shipping → Courier Providers.
# Example for courier code FAST:
# COURIER_FAST_API_BASE_URL=https://courier.example/api
# COURIER_FAST_CREATE_PATH=/shipments
# COURIER_FAST_API_TOKEN=
# COURIER_FAST_WEBHOOK_SECRET=
