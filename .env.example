# Django core
# Production: use a unique random secret of at least 32 characters and DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=change-this-before-production-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated origins including scheme, only when cross-origin CSRF trust is required.
DJANGO_CSRF_TRUSTED_ORIGINS=

# MySQL 8
DB_NAME=techbari
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Staff authentication / session security
STAFF_AUTH_ENABLED=1
STAFF_IDLE_TIMEOUT=1800
SESSION_COOKIE_AGE=28800
SESSION_COOKIE_NAME=techbari_sessionid
PASSWORD_RESET_TIMEOUT=3600
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW=900
AUTH_LOCKOUT_SECONDS=900

# Production HTTPS. Defaults become secure automatically when DJANGO_DEBUG=0.
# Enable forwarded headers only when your reverse proxy overwrites/sanitizes them.
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
TRUST_X_FORWARDED_PROTO=0
TRUST_X_FORWARDED_FOR=0

# Request/upload limits
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_NUMBER_FIELDS=2000

# Logging
DJANGO_LOG_LEVEL=INFO
DJANGO_FRAMEWORK_LOG_LEVEL=WARNING

# Email / SMTP. Console backend is local-development only.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@techbari.local
SERVER_EMAIL=noreply@techbari.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15

# v2.8+ Notifications / Integrations secrets. Never put these in dashboard fields.
SMS_API_TOKEN=
WHATSAPP_API_TOKEN=
META_CAPI_ACCESS_TOKEN=
# Keep Graph API version configurable so it can be upgraded without a code release.
META_GRAPH_API_VERSION=
META_CAPI_BASE_URL=https://graph.facebook.com
GA4_API_SECRET=
GA4_MEASUREMENT_PROTOCOL_URL=https://www.google-analytics.com/mp/collect

# Outbound/webhook security. HTTPS + signed timestamps default on when DEBUG=0.
INTEGRATION_REQUIRE_HTTPS=0
COURIER_WEBHOOK_REQUIRE_TIMESTAMP=0
COURIER_WEBHOOK_MAX_SKEW_SECONDS=300
COURIER_WEBHOOK_MAX_BYTES=65536
COURIER_WEBHOOK_RECEIPT_DAYS=7

# Generic courier fallback secrets.
COURIER_API_TOKEN=
COURIER_WEBHOOK_SECRET=

# Per-courier variables use the provider CODE configured in Shipping → Courier Providers.
# Example for courier code FAST:
# COURIER_FAST_API_BASE_URL=https://courier.example/api
# COURIER_FAST_CREATE_PATH=/shipments
# COURIER_FAST_API_TOKEN=
# COURIER_FAST_WEBHOOK_SECRET=

# Production example (adjust to your real HTTPS domain/proxy):
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=3600
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# TRUST_X_FORWARDED_PROTO=1   # only if your proxy sanitizes X-Forwarded-Proto
# TRUST_X_FORWARDED_FOR=1     # only if your proxy sanitizes X-Forwarded-For
# INTEGRATION_REQUIRE_HTTPS=1
# COURIER_WEBHOOK_REQUIRE_TIMESTAMP=1
